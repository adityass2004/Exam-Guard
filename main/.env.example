# ExamGuard Environment Configuration
# Copy this file to .env or run `npm run setup` to auto-generate keys.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------------
# Runtime & Network Ports
# -----------------------------------------------------------------------------
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
VISION_PORT=8000

# Web Origin (used for CORS allowlist, CSRF origin verification, and WebSocket handshakes)
WEB_ORIGIN=http://localhost:3000

# Internal API URL (used by Next.js app rewrite: /api/:path* -> ${API_URL}/api/:path*)
API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Database Configuration (MySQL 8.x via Prisma)
# -----------------------------------------------------------------------------
# Note: Special characters in user/password must be URL-encoded.
DATABASE_URL=mysql://examguard:examguard_dev_password@localhost:3306/examguard
TEST_DATABASE_URL=mysql://examguard:examguard_dev_password@localhost:3306/examguard_test

# -----------------------------------------------------------------------------
# Session Security
# -----------------------------------------------------------------------------
# Session idle timeout (in minutes)
SESSION_IDLE_MINUTES=30
# Session absolute lifetime (in hours)
SESSION_ABSOLUTE_HOURS=8

# -----------------------------------------------------------------------------
# Encryption Keys (AES-256-GCM - exactly 32 bytes encoded in Base64)
# Generated automatically by `npm run setup` / `scripts/gen-secrets.mjs`
# -----------------------------------------------------------------------------
EMBEDDING_ENCRYPTION_KEY=REPLACE_ME
IMAGE_ENCRYPTION_KEY=REPLACE_ME
ENCRYPTION_KEY_VERSION=1

# -----------------------------------------------------------------------------
# Local Storage
# -----------------------------------------------------------------------------
# Private storage directory for encrypted enrollment images and evidence
STORAGE_ROOT=./storage

# -----------------------------------------------------------------------------
# Vision Service Integration (Node -> Python FastAPI)
# -----------------------------------------------------------------------------
VISION_URL=http://127.0.0.1:8000
# Internal shared secret passed in X-Internal-Key header (never public)
VISION_INTERNAL_KEY=REPLACE_ME
# Request timeout in milliseconds from Node to Python service
VISION_TIMEOUT_MS=4000
# Directory where InsightFace models reside
VISION_MODEL_DIR=./services/vision/models
# Whether InsightFace is allowed to download models automatically if absent
VISION_ALLOW_MODEL_DOWNLOAD=true
# Maximum concurrent inference requests processed in Python service
VISION_MAX_CONCURRENCY=2

# -----------------------------------------------------------------------------
# Default Seed Credentials (Generated automatically by setup)
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@examguard.local
SEED_ADMIN_PASSWORD=REPLACE_ME
SEED_STUDENT_EMAIL=student@examguard.local
SEED_STUDENT_PASSWORD=REPLACE_ME

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info

